# Rendered by scripts/deploy_webapp.sh, which substitutes $DOMAIN, $APP_ROOT, $PUBLIC_PORT and $PORT (and
# nothing else -- every other $ here is nginx's own) and installs the result as
# /etc/nginx/conf.d/coffee-cv.conf on the host -- this template stays domain-generic
# so the real domain never enters git (see webapp/README.md).

# Deliberately no $remote_addr (or any other client-IP variable) in this
# format -- see docs/logging_plan.html section 03-C for why. $request_id is
# nginx's own per-connection id and is NOT what joins a line here to the
# app's own log: webapp/app.py generates its own id and returns it as an
# X-Request-Id response header, captured below via $upstream_http_x_request_id,
# so the app stays the one source of truth for the id and nginx never needs
# to originate or track one of its own.
# $upstream_bytes_received ends the line (ticket OPS-7 D19): /analyze's 200 goes out with its first part, so a
# worker killed mid-answer still logs a 200 here, with fewer bytes than a whole answer.
log_format coffee_cv_minimal '$time_iso8601 $upstream_http_x_request_id $status "$request" ${request_time}s $upstream_bytes_received';

# One shared, server-wide cap on concurrent requests to the Python backend --
# keyed on a fixed value, not per-IP or per-connection, deliberately: NAT means
# many real users can share one IP, and the goal here is protecting the single
# gunicorn worker's capacity, not identifying any one client. Set to 1 to match
# that single worker one-for-one: a second request while one is in flight gets
# an immediate 503 instead of queueing toward gunicorn's 30s timeout. /analyze
# is the one route to the worker (ticket OPS-7); a route added beside it would
# have to share this zone, since they would hit the same one worker.
limit_conn_zone $server_name zone=coffee_cv_inflight:1m;

# One port, TLS only, behind the proxy that serves the domain on 80/443 and forwards here: no port-80
# server of our own. A plain-http request (nginx's 497) is redirected to the public https URL.
server {
    listen $PUBLIC_PORT ssl;
    listen [::]:$PUBLIC_PORT ssl;
    server_name $DOMAIN;
    error_page 497 =301 https://$host$request_uri;

    # domain.cert.pem is Porkbun's naming and already contains the full chain
    # (leaf + intermediates concatenated) -- no separate fullchain build step.
    ssl_certificate     /etc/nginx/ssl/coffee-cv/domain.cert.pem;
    ssl_certificate_key /etc/nginx/ssl/coffee-cv/private.key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;

    # A dedicated file, not the distro's default /var/log/nginx/access.log --
    # deliberately named without a .log suffix so Ubuntu's stock
    # /etc/logrotate.d/nginx (which globs /var/log/nginx/*.log) never touches
    # it; webapp/deploy/coffee-cv.logrotate is the only thing that rotates
    # this one, at the retention docs/logging_plan.html section 06 sets.
    access_log /var/log/nginx/coffee-cv.access coffee_cv_minimal;

    # The page comes from the release, beside the API it calls: nginx follows the `current`
    # symlink on every request, so page and backend switch together at the deploy's flip, with
    # no copy step to forget (docs/ops1_release_isolation_plan.html §4.6).
    root $APP_ROOT/current/webapp/static;

    location / {
        index index.html;
        try_files $uri /index.html;
    }

    # Both ways to the page (`index` and the `try_files` fallback) are internal redirects that land here, so every
    # load revalidates it: the browser always holds the page of the release the server runs (ticket OPS-7 D5).
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location = /analyze {
        limit_conn coffee_cv_inflight 1;
        client_max_body_size 20m;
        proxy_read_timeout 30s;
        proxy_pass http://127.0.0.1:$PORT;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # The app streams the answer, preview first, with X-Accel-Buffering: no, which turns off this nginx's
        # buffering. nginx hides X-Accel-* from the client by default; passing it on turns off the proxy's in front
        # of the domain too (ticket OPS-7 D11).
        proxy_pass_header X-Accel-Buffering;
        # With buffering off, nginx still reads up to this much from the app ahead of the client: the whole answer
        # (a preview of a few hundred KB, then about 1 KB), so the single sync worker never waits on a slow phone,
        # nor gets killed at gunicorn's 30 s timeout by one that stops reading (ticket OPS-7 D18, R9). nginx -t
        # wants proxy_busy_buffers_size (2 x the largest buffer by default) below all proxy_buffers but one; the
        # buffers are only used for an answer that is buffered, the app's 400s, and the cap allows one at a time.
        proxy_buffer_size 1m;
        proxy_buffers 4 1m;
    }
}
