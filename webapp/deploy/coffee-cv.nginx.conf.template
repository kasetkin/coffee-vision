# Rendered by setup_server.sh, which substitutes $DOMAIN and writes the result to
# /etc/nginx/conf.d/coffee-cv.conf on the VM -- this template stays domain-generic
# so the real domain never enters git (see webapp/README.md).

# One shared, server-wide cap on concurrent /classify requests -- keyed on a fixed
# value, not per-IP or per-connection, deliberately: NAT means many real users can
# share one IP, and the goal here is protecting the single gunicorn worker's
# capacity, not identifying any one client. Set to 1 to match that single worker
# one-for-one: a second request while one is in flight gets an immediate 503
# instead of queueing toward gunicorn's 30s timeout.
limit_conn_zone $server_name zone=coffee_cv_inflight:1m;

server {
    listen 80;
    listen [::]:80;
    server_name $DOMAIN;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name $DOMAIN;

    ssl_certificate     /etc/nginx/ssl/coffee-cv/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/coffee-cv/private.key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;

    root /var/www/coffee-cv;

    location / {
        index index.html;
        try_files $uri /index.html;
    }

    location /classify {
        limit_conn coffee_cv_inflight 1;
        client_max_body_size 20m;
        proxy_read_timeout 30s;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
