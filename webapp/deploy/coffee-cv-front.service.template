# The front's check service (ticket OPS-15, ADR 0031), on the proxy. Rendered with $FRONT_SERVICE_USER and
# $RELEASE_DIR ($FRONT_APP_ROOT/current) and installed as /etc/systemd/system/coffee-cv-front.service by
# webapp/deploy/setup_front.sh, as root, once: the deploy's user may only stop, start and restart it (D9), and its
# stage refuses a release whose rendered unit differs from the installed one. Nothing here changes per release: the
# release's front.env names the listen address and the inference host, and systemd resolves `current` at each start,
# so a flip or a rollback moves the service with the page.
[Unit]
Description=Coffee CV front: the upload check service (ticket OPS-15)
After=network.target

[Service]
Type=simple
User=$FRONT_SERVICE_USER
Group=$FRONT_SERVICE_USER
WorkingDirectory=$RELEASE_DIR
# COFFEE_CV_FRONT_LISTEN and COFFEE_CV_INFERENCE_URL (webapp/front/check_service.py, options).
EnvironmentFile=$RELEASE_DIR/front.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=$RELEASE_DIR/.venv/bin/python $RELEASE_DIR/webapp/front/check_service.py
Restart=on-failure
RestartSec=2
MemoryMax=600M
# Its one JSON line per request (ticket OPS-3 D9): systemd makes /var/log/coffee-cv-front for the service's user,
# leaves it writable under ProtectSystem=strict, the one path the service writes, and names it in $LOGS_DIRECTORY,
# which check_service.py reads. Only its start-up line goes to the journal.
LogsDirectory=coffee-cv-front

# It parses attacker-supplied form data from the internet, so the same containment as the app's unit
# (coffee-cv-web.service.template).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
