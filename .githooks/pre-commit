#!/usr/bin/env bash
# Runs three checks on every commit, all always, so one commit reports every failure:
# - coffeecv.leak_check: no public IP, email, credential or photo GPS. The repo is public and its history is
#   not rewritten, so a leak has to be stopped before it is committed: the pre-push check (scripts/check.sh)
#   would only find it in history. It checks each staged file as it is staged, from the index (OPS-5).
# - coffeecv.ruff_staged: `ruff check` on the staged Python files as they stand in the index (OPS-4).
# - coffeecv.lock_check: a package the three uv locks share is held at one version in all of them (ML-19 D41;
#   ADR 0033). It reads the working-tree locks, standard library only (no torch), in about 0.2 s.
# leak_check and ruff_staged take about 0.35 s each to start (no torch); Ruff adds about 85 ms per staged Python
# file, and leak_check about 0.3 s when an image is staged (exiftool). The hook on 30 staged Python files: 3.4 s
# before OPS-5, 3.5 s after (leak_check 0.33 s, then 0.35 s; ruff_staged 2.9 s of it). Measured 2026-11-08.
# Bypass once with `git commit --no-verify`.
set -uo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root" || exit 1
rc=0
python -m coffeecv.leak_check --staged || rc=1
python -m coffeecv.ruff_staged || rc=1
python -m coffeecv.lock_check || rc=1
exit $rc
