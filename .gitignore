/.claude/settings.local.json
# Claude Code user config bind-mounted by .devcontainer (holds credentials) -- never commit
/.private_claude/
# SSH keys for this devcontainer: in the workspace bind mount so they survive a rebuild -- never commit
/.private_ssh/
__pycache__/
# `/outputs/*`, not `/outputs/`, so that a file under it can be re-included: git cannot re-include a file whose
# parent *directory* is excluded. None is today: ML-2's seg_eval metrics were, until their stage was removed on
# 2026-10-21 (and the ResNet trainer's metrics.json and summary.json until 2026-10-20).
/outputs/*
/tensorboard/
/dvc_plots/
*.pt
*.kate-swp
/.ood_eval_cache/
# heavy OOD sidecars belong in DVC alongside the .pt, not in git history
*.ood_embeddings.npz
# Pretrained upstream backbones: the weights are large and, for DINOv3, not ours to
# redistribute -- but models_pretrained/README.md and manifest.json MUST stay tracked.
# They are the acquisition instructions and the checksums, i.e. the only way a fresh
# clone can obtain and verify the right files. Ignoring the whole directory (as this
# line did until 2026-09-21) hid exactly the two files that make it reproducible.
/models_pretrained/**/*.pth
/models_pretrained/**/*.pt
/models_pretrained/**/*.safetensors
/webapp/BUILD_INFO.json
# ML-5 labelling sessions (coffeecv/seg_review.py): every mask under data/ml5_labels/<session>/ is ignored from
# the session's first click, not only once `dvc add data/ml5_labels/<session>` writes a .gitignore of its own,
# so a `git add -A` mid-session stages no mask (docs/agents/dvc.md, "Keeping git and DVC apart"). The children,
# not the directory: DVC refuses to write a .dvc file git ignores, so <session>.dvc is re-included.
/data/ml5_labels/*
!/data/ml5_labels/*.dvc

VERY_BIG_NEGATIVES/
